# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=replace_with_a_long_random_hex_value
# Use URL-safe characters; changing this after Mongo initialization requires migration.
MONGO_PASSWORD=replace_with_a_different_long_random_hex_value
MAX_UPLOAD_MB=25
RETENTION_HOURS=24
# Optional: build a CPU GNN image and mount a trusted checkpoint via local Compose override.
INSTALL_GNN=0
MODEL_CHECKPOINT=
